{
  "name": "acme-cartoon-o-matic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The ACME Cartoon-O-Matic 4000: a spinning selector for Looney Tunes Golden Collection Volumes 1-4.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "audit:catalog": "vitest run tests/catalog.test.ts --reporter=verbose",
    "qa": "node scripts/qa-screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/limelight": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/rye": "^5.3.0",
    "@fontsource/shrikhand": "^5.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1",
    "@types/react-dom": "19.1",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "1.56",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
